#pragma code_page(65001)

#include "winres.h"
#include "../src/resource.h"
#include <winver.h>
#include "../src/version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EVERYTHINGSHELL_VERSION_MAJOR,EVERYTHINGSHELL_VERSION_MINOR,EVERYTHINGSHELL_VERSION_BUILD,EVERYTHINGSHELL_VERSION_REVISION
 PRODUCTVERSION EVERYTHINGSHELL_VERSION_MAJOR,EVERYTHINGSHELL_VERSION_MINOR,EVERYTHINGSHELL_VERSION_BUILD,EVERYTHINGSHELL_VERSION_REVISION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "voidtools"
            VALUE "FileDescription", "Everything Shell Extension"
            VALUE "FileVersion", EVERYTHINGSHELL_VERSION_STR
            VALUE "InternalName", "EverythingShell"
            VALUE "LegalCopyright", "Copyright (C) 2026 voidtools / David Carpenter"
            VALUE "OriginalFilename", "EverythingShell.dll"
            VALUE "ProductName", "Everything Shell Extension"
            VALUE "ProductVersion", EVERYTHINGSHELL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_EVERYTHING ICON "Everything.ico"
STRINGTABLE
BEGIN
    IDS_SEARCH_EVERYTHING "Search Everything..."
END

LANGUAGE LANG_GERMAN, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
    IDS_SEARCH_EVERYTHING "Mit Everything suchen..."
END

